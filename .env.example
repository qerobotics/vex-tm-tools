# QEComp backend environment variables (plan §15, Appendix B.1).
# Copy to .env and fill in real values for local dev; in k8s these are
# provided via Secrets/ConfigMaps (see k8s/ manifests, added in a later wave).

# ── Core infra ────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://qecomp:qecomp@localhost:5433/qecomp
REDIS_URL=redis://localhost:6380/0

# ── OIDC (Authentik) — see docs/AUTHENTIK_SETUP.md (later wave) ────────
OIDC_ISSUER_URL=https://authentik.example.com/application/o/qecomp/
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme
OIDC_GROUPS_CLAIM=groups

# ── Local emergency admin (plan §3.9) ──────────────────────────────────
ADMIN_LOCAL_PASSWORD=changeme

# ── Secrets ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme

# ── S3 / MinIO (plan §3.8 — also configurable from the Settings UI) ────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=qecomp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── App / cluster ────────────────────────────────────────────────────────
APP_PORT=8000
# POD_IP is normally injected via the k8s downward API; leave unset locally.
POD_IP=
